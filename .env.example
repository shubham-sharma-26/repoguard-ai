# Optional GitHub API token raises the unauthenticated rate limit. Never commit a real .env.
GITHUB_TOKEN=
# Leave unset for local SQLite. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://repoguard:local-development-only@localhost:5432/repoguard
CORS_ORIGINS=http://localhost:5173
MAX_FILES=2500
MAX_FILE_BYTES=500000
MAX_TOTAL_BYTES=25000000
REQUEST_TIMEOUT=20
# Optional RAG provider. Configuring this key opts in to sending repository
# chunks for embeddings and retrieved excerpts for answer generation to OpenAI.
# Leave blank for local lexical retrieval and extractive answers only.
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4o-mini
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_MAX_CHUNKS=256
RAG_CHUNK_MAX_CHARS=8000
RAG_RETRIEVED_CHUNKS=5
RAG_CONTEXT_MAX_CHARS=12000
RAG_MIN_SIMILARITY=0.2
RAG_PROVIDER_TIMEOUT=12
RAG_REQUEST_TIMEOUT=20
RAG_PROVIDER_RESPONSE_BYTES=2000000
