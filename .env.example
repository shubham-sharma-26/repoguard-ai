# Optional GitHub API token raises the unauthenticated rate limit. Never commit a real .env.
GITHUB_TOKEN=
# Leave unset for local SQLite. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://repoguard:local-development-only@localhost:5432/repoguard
CORS_ORIGINS=http://localhost:5173
MAX_FILES=2500
MAX_FILE_BYTES=500000
MAX_TOTAL_BYTES=25000000
REQUEST_TIMEOUT=20
